{
  "name": "@elo-ui/components",
  "version": "0.0.0",
  "description": "Accessible, framework-agnostic web components.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "accessibility",
    "a11y",
    "ui",
    "components",
    "dashboard"
  ],
  "homepage": "https://github.com/AAMILLERDEV/elo-ui/tree/master/packages/components#readme",
  "bugs": {
    "url": "https://github.com/AAMILLERDEV/elo-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAMILLERDEV/elo-ui.git",
    "directory": "packages/components"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./alert": {
      "types": "./dist/alert/alert.d.ts",
      "default": "./dist/alert/alert.js"
    },
    "./badge": {
      "types": "./dist/badge/badge.d.ts",
      "default": "./dist/badge/badge.js"
    },
    "./button": {
      "types": "./dist/button/button.d.ts",
      "default": "./dist/button/button.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/checkbox.d.ts",
      "default": "./dist/checkbox/checkbox.js"
    },
    "./dialog": {
      "types": "./dist/dialog/dialog.d.ts",
      "default": "./dist/dialog/dialog.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/dropdown.d.ts",
      "default": "./dist/dropdown/dropdown.js"
    },
    "./input": {
      "types": "./dist/input/input.d.ts",
      "default": "./dist/input/input.js"
    },
    "./menu-item": {
      "types": "./dist/menu-item/menu-item.d.ts",
      "default": "./dist/menu-item/menu-item.js"
    },
    "./menu-separator": {
      "types": "./dist/menu-separator/menu-separator.d.ts",
      "default": "./dist/menu-separator/menu-separator.js"
    },
    "./popover": {
      "types": "./dist/popover/popover.d.ts",
      "default": "./dist/popover/popover.js"
    },
    "./progress": {
      "types": "./dist/progress/progress.d.ts",
      "default": "./dist/progress/progress.js"
    },
    "./radio": {
      "types": "./dist/radio/radio.d.ts",
      "default": "./dist/radio/radio.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/radio-group.d.ts",
      "default": "./dist/radio-group/radio-group.js"
    },
    "./select": {
      "types": "./dist/select/select.d.ts",
      "default": "./dist/select/select.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton/skeleton.d.ts",
      "default": "./dist/skeleton/skeleton.js"
    },
    "./spinner": {
      "types": "./dist/spinner/spinner.d.ts",
      "default": "./dist/spinner/spinner.js"
    },
    "./switch": {
      "types": "./dist/switch/switch.d.ts",
      "default": "./dist/switch/switch.js"
    },
    "./textarea": {
      "types": "./dist/textarea/textarea.d.ts",
      "default": "./dist/textarea/textarea.js"
    },
    "./toast": {
      "types": "./dist/toast/toast.d.ts",
      "default": "./dist/toast/toast.js"
    },
    "./toast-region": {
      "types": "./dist/toast-region/toast-region.d.ts",
      "default": "./dist/toast-region/toast-region.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/tooltip.d.ts",
      "default": "./dist/tooltip/tooltip.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cem analyze",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@elo-ui/core": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@elo-ui/build-tools": "workspace:*",
    "axe-core": "^4.14.0",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
