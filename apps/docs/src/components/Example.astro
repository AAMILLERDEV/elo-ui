---
import { Code } from 'astro:components';
import { codeThemes } from '../code-themes';

interface Props {
  /** Markup rendered as the live preview and shown as the HTML snippet. */
  code: string;
  /** Stack items vertically, for form fields. */
  stack?: boolean;
}

const { code, stack = false } = Astro.props;
---

<figure class="example">
  <div class:list={['preview', { stack }]} set:html={code} />
  <Code code={code.trim()} lang="html" themes={codeThemes} />
</figure>

<style>
  .example {
    margin: 1rem 0 0;
    overflow: hidden;
    border: 1px solid var(--elo-color-border);
    border-radius: var(--elo-radius-lg);
  }

  .preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 1.5rem;
    background: var(--elo-color-surface);
  }

  .preview.stack {
    flex-direction: column;
    align-items: stretch;
  }

  .preview.stack > :global(*) {
    max-width: 24rem;
  }

  .preview :global(form) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .preview :global(form > :not(elo-button)) {
    align-self: stretch;
  }

  .example :global(pre.astro-code) {
    border-top: 1px solid var(--elo-color-border);
    border-radius: 0;
  }
</style>
