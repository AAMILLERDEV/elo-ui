---
import manifest from '@elo-ui/components/custom-elements.json';

interface Props {
  tag: string;
}

interface Member {
  kind: string;
  name: string;
  type?: { text: string };
  default?: string;
  description?: string;
  attribute?: string;
  readonly?: boolean;
  privacy?: string;
  static?: boolean;
}

interface Declaration {
  tagName?: string;
  customElement?: boolean;
  members?: Member[];
  slots?: { name: string; description?: string }[];
  cssParts?: { name: string; description?: string }[];
  events?: { name: string; type?: { text: string }; description?: string }[];
}

const { tag } = Astro.props;
const declaration = (manifest.modules as { declarations?: Declaration[] }[])
  .flatMap((mod) => mod.declarations ?? [])
  .find((decl) => decl.customElement && decl.tagName === tag);

if (!declaration) throw new Error(`No manifest entry for <${tag}>`);

const props = (declaration.members ?? []).filter(
  (m) => m.kind === 'field' && !m.static && !m.privacy && !m.name.startsWith('#'),
);
const slots = declaration.slots ?? [];
const parts = declaration.cssParts ?? [];
const events = declaration.events ?? [];
---

<h3>Properties</h3>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Property</th>
        <th>Attribute</th>
        <th>Type</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {props.map((p) => (
        <tr>
          <td>
            <code>{p.name}</code>
          </td>
          <td>{p.attribute ? <code>{p.attribute}</code> : '—'}</td>
          <td>
            <code>{p.type?.text ?? 'unknown'}</code>
          </td>
          <td>{p.default ? <code>{p.default}</code> : p.readonly ? 'read-only' : '—'}</td>
          <td>{p.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

{events.length > 0 && (
  <>
    <h3>Events</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Event</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {events.map((e) => (
            <tr>
              <td>
                <code>{e.name}</code>
              </td>
              <td>
                <code>{e.type?.text}</code>
              </td>
              <td>{e.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>
)}

<h3>Slots</h3>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Slot</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {slots.map((s) => (
        <tr>
          <td>
            <code>{s.name || '(default)'}</code>
          </td>
          <td>{s.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<h3>CSS parts</h3>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Part</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {parts.map((p) => (
        <tr>
          <td>
            <code>{p.name}</code>
          </td>
          <td>{p.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
