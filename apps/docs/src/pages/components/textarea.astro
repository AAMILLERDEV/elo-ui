---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ApiReference from '../../components/ApiReference.astro';
---

<Docs
  title="Textarea"
  description="An accessible multi-line text field web component with a built-in label, hint, and validation."
>
  <h1>Textarea</h1>
  <p class="lede">
    A multi-line text field built on the native <code>&lt;textarea&gt;</code>. See{' '}
    <a href="/guides/forms">Forms</a> for validation and events.
  </p>

  <h2>Basic</h2>
  <Example
    stack
    code={`<elo-textarea label="Description" hint="Markdown is supported."></elo-textarea>`}
  />

  <h2>Rows and resizing</h2>
  <Example
    stack
    code={`<elo-textarea label="Release notes" rows="6"></elo-textarea>
<elo-textarea label="Summary" rows="2" resize="none" maxlength="140"></elo-textarea>`}
  />

  <h2>Validation</h2>
  <Example stack code={`<elo-textarea label="Feedback" required minlength="20"></elo-textarea>`} />

  <h2>API</h2>
  <ApiReference tag="elo-textarea" />
</Docs>
