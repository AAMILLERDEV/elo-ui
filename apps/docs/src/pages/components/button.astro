---
import { Code } from 'astro:components';
import { codeThemes } from '../../code-themes';
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ApiReference from '../../components/ApiReference.astro';

const plus = `<svg slot="start" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3 8h10"/></svg>`;
const arrow = `<svg slot="end" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>`;
const gear = `<svg slot="start" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg>`;

const frameworks = {
  react: `import { EloButton } from '@elo-ui/react';

export function SaveButton({ saving }: { saving: boolean }) {
  return (
    <EloButton variant="primary" type="submit" loading={saving}>
      Save changes
    </EloButton>
  );
}`,
  vue: `<!-- vite.config.ts: vue({ template: { compilerOptions: eloCompilerOptions } }) -->
<script setup lang="ts">
import '@elo-ui/components/button';
defineProps<{ saving: boolean }>();
</script>

<template>
  <elo-button variant="primary" type="submit" :loading="saving">
    Save changes
  </elo-button>
</template>`,
  angular: `import { Component, input } from '@angular/core';
import { EloButton } from '@elo-ui/angular';

@Component({
  selector: 'app-save-button',
  imports: [EloButton],
  template: \`
    <elo-button variant="primary" type="submit" [loading]="saving()">
      Save changes
    </elo-button>
  \`,
})
export class SaveButton {
  saving = input(false);
}`,
};
---

<Docs
  title="Button"
  description="An accessible button web component with variants, sizes, icons, loading state, link mode, and native form support."
>
  <h1>Button</h1>
  <p class="lede">
    Triggers an action, submits a form, or navigates. Renders a real <code>&lt;button&gt;</code> or
    <code>&lt;a&gt;</code>, so keyboard, form, and screen reader behavior match the platform.
  </p>

  <h2>Variants</h2>
  <p>
    Use one <code>primary</code> button per view for the main action.
  </p>
  <Example
    code={`<elo-button variant="primary">Save</elo-button>
<elo-button>Cancel</elo-button>
<elo-button variant="ghost">More</elo-button>
<elo-button variant="danger">Delete</elo-button>`}
  />

  <h2>Sizes</h2>
  <p>
    Heights also follow density: switch to <em>Compact</em> in the header to compare.
  </p>
  <Example
    code={`<elo-button size="sm">Small</elo-button>
<elo-button>Medium</elo-button>
<elo-button size="lg">Large</elo-button>`}
  />

  <h2>Icons</h2>
  <p>
    Put icons in the <code>start</code> or <code>end</code> slot and mark them
    <code>aria-hidden</code>. Icon-only buttons need a <code>label</code>.
  </p>
  <Example
    code={`<elo-button variant="primary">${plus}New project</elo-button>
<elo-button>Continue${arrow}</elo-button>
<elo-button label="Settings">${gear}</elo-button>`}
  />

  <h2>Loading</h2>
  <p>
    A loading button keeps its width and stays focusable, but ignores clicks so forms can't be
    submitted twice.
  </p>
  <Example code={`<elo-button variant="primary" loading>Saving</elo-button>`} />

  <h2>Disabled</h2>
  <Example
    code={`<elo-button variant="primary" disabled>Save</elo-button>
<elo-button disabled>Cancel</elo-button>`}
  />

  <h2>Links</h2>
  <p>
    Set <code>href</code> to render a native link that looks like a button.
  </p>
  <Example code={`<elo-button href="#links" variant="ghost">View docs${arrow}</elo-button>`} />

  <h2>Forms</h2>
  <p>
    <code>type="submit"</code> runs native validation and submits the button's <code>name</code>
    and <code>value</code>, exactly like a native button.
  </p>
  <Example
    code={`<form onsubmit="event.preventDefault(); this.querySelector('output').value = 'Submitted: ' + new FormData(this, event.submitter).get('intent')">
  <elo-button type="submit" name="intent" value="draft">Save draft</elo-button>
  <elo-button type="submit" name="intent" value="publish" variant="primary">Publish</elo-button>
  <output aria-live="polite"></output>
</form>`}
  />

  <h2>Frameworks</h2>
  <h3>React</h3>
  <Code code={frameworks.react} lang="tsx" themes={codeThemes} />
  <h3>Vue</h3>
  <Code code={frameworks.vue} lang="vue" themes={codeThemes} />
  <h3>Angular</h3>
  <Code code={frameworks.angular} lang="ts" themes={codeThemes} />

  <h2>Accessibility</h2>
  <h3>Keyboard</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Key</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <kbd>Tab</kbd>
          </td>
          <td>Moves focus to the button. Disabled buttons are skipped; loading buttons are not.</td>
        </tr>
        <tr>
          <td>
            <kbd>Enter</kbd>
          </td>
          <td>Activates the button or follows the link.</td>
        </tr>
        <tr>
          <td>
            <kbd>Space</kbd>
          </td>
          <td>Activates the button (not links, matching native behavior).</td>
        </tr>
      </tbody>
    </table>
  </div>
  <h3>Screen readers</h3>
  <ul>
    <li>
      Announced as a button, or as a link when <code>href</code> is set.
    </li>
    <li>
      Loading buttons are announced as unavailable (<code>aria-disabled</code>) and keep their
      label.
    </li>
    <li>
      Icon-only buttons take their name from <code>label</code>; a console warning flags missing
      labels.
    </li>
    <li>
      Supports Windows High Contrast (<code>forced-colors</code>) and reduced motion.
    </li>
  </ul>

  <h2>API</h2>
  <ApiReference tag="elo-button" />
</Docs>
