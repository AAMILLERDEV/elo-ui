---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ApiReference from '../../components/ApiReference.astro';
---

<Docs
  title="Icon button"
  description="An accessible icon-only button web component whose label is announced and shown as a tooltip."
>
  <h1>Icon button</h1>
  <p class="lede">
    A square button that shows only an icon. The required <code>label</code> is its accessible name
    and appears as a tooltip on hover and focus, so every user knows what it does.
  </p>

  <h2>Basic</h2>
  <Example
    code={`<elo-icon-button label="Settings"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg></elo-icon-button>
<elo-icon-button label="More actions"><svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><circle cx="3.5" cy="8" r="1.25"/><circle cx="8" cy="8" r="1.25"/><circle cx="12.5" cy="8" r="1.25"/></svg></elo-icon-button>
<elo-icon-button label="Delete" variant="danger"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.5 8.5h6l.5-8.5"/></svg></elo-icon-button>`}
  />

  <h2>Sizes</h2>
  <Example
    code={`<elo-icon-button label="Settings" size="sm"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg></elo-icon-button>
<elo-icon-button label="Settings"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg></elo-icon-button>
<elo-icon-button label="Settings" size="lg"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg></elo-icon-button>`}
  />

  <p>
    It supports everything <a href="/components/button">Button</a> does, including <code>href</code>
    , <code>loading</code>, and form submission. Mark the icon <code>aria-hidden="true"</code>.
  </p>

  <h2>API</h2>
  <ApiReference tag="elo-icon-button" />
</Docs>
