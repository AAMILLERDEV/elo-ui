---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ApiReference from '../../components/ApiReference.astro';
---

<Docs
  title="Accordion"
  description="An accessible accordion web component with collapsible sections, following the WAI-ARIA accordion pattern."
>
  <h1>Accordion</h1>
  <p class="lede">
    A stack of collapsible sections. Each header is a button inside a heading, so screen reader
    users can jump between sections.
  </p>

  <h2>Basic</h2>
  <Example
    code={`<elo-accordion style="width: 100%">
  <elo-accordion-item heading="How do I invite teammates?" open>Open Settings, then Members, and choose Invite.</elo-accordion-item>
  <elo-accordion-item heading="Can I change my plan later?">Yes. Changes apply from the next billing cycle.</elo-accordion-item>
  <elo-accordion-item heading="Is there a free trial?">Every plan includes a 14-day trial.</elo-accordion-item>
</elo-accordion>`}
  />

  <h2>One open at a time</h2>
  <Example
    code={`<elo-accordion exclusive style="width: 100%">
  <elo-accordion-item heading="Shipping">Orders ship within 2 business days.</elo-accordion-item>
  <elo-accordion-item heading="Returns">Return unused items within 30 days.</elo-accordion-item>
</elo-accordion>`}
  />

  <h2>Keyboard</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Key</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <kbd>Enter / Space</kbd>
          </td>
          <td>Expands or collapses the focused section.</td>
        </tr>
        <tr>
          <td>
            <kbd>Arrow Down / Up</kbd>
          </td>
          <td>Moves to the next or previous header.</td>
        </tr>
        <tr>
          <td>
            <kbd>Home / End</kbd>
          </td>
          <td>Moves to the first or last header.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>API</h2>
  <ApiReference tag="elo-accordion" />
  <ApiReference tag="elo-accordion-item" />
</Docs>
