{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "custom-elements.json", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["ELO_BROWSERS"],
      "passThroughEnv": ["LOCALAPPDATA", "PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:package": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
